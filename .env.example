# --- Gmail (Google Cloud OAuth client, "Desktop app" type) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Obtained by running `npm run gmail:auth` once.
GMAIL_REFRESH_TOKEN=
# Gmail search query used to find candidate emails each scan.
GMAIL_QUERY=in:inbox -label:bill-scanned newer_than:30d
# Applied to every scanned email so it's never re-scanned, regardless of outcome.
GMAIL_SCANNED_LABEL=bill-scanned
# Applied to bills waiting for your approval in the review UI.
GMAIL_PENDING_LABEL=bill-pending-review
# Applied once you approve a bill and it's created in QuickBooks.
GMAIL_APPROVED_LABEL=bill-approved
# Applied if you reject a bill in the review UI.
GMAIL_REJECTED_LABEL=bill-rejected

# --- QuickBooks Online (Intuit developer app) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" while testing, "production" when ready to write real bills.
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/oauth2callback
# Fallback expense account (by name, exact match) used when Claude's
# suggested category doesn't match an existing QBO account.
QBO_DEFAULT_EXPENSE_ACCOUNT=Utilities

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Behavior ---
# Nothing is ever entered into QuickBooks without your approval in the review
# UI. This only controls whether a pending bill gets a "needs a closer look"
# badge in the UI (low confidence, or a missing vendor/amount).
CONFIDENCE_THRESHOLD=0.75
# Where local state (the bill review queue and history) is stored.
DB_PATH=./data/state.sqlite3

# --- Review UI ---
# Binds to localhost by default — this UI can trigger real QuickBooks writes,
# so don't change SERVER_HOST unless you're putting your own auth in front of it.
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
